# Sarvam AI Credentials & Models
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=msmarco_xi

# Embedding Model Config
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Dataset Configuration
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_CONFIG=en
DATASET_SPLIT=train

# RAG & Chunking Parameters
TOP_K=10
RRF_K=60
CHUNK_STRATEGY=semantic
MAX_CONTEXT_CHUNKS=5
CHUNK_SIZE=150
CHUNK_OVERLAP=30
SEMANTIC_THRESHOLD=0.75

# Guardrails & Scoring Thresholds
RETRIEVAL_THRESHOLD=0.10
GROUNDING_THRESHOLD=0.60
USE_RERANKER=false

# Application Settings
ENVIRONMENT=development
MOCK_EXTERNAL_SERVICES=false
LOG_LEVEL=INFO
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
